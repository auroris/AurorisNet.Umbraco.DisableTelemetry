<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile the package against the oldest supported API. A site restores its own Umbraco release. -->
    <PackageVersion Include="Umbraco.Cms.Infrastructure" Version="[$(UmbracoMinimumVersion), $(UmbracoMaximumVersion)]" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[$(UmbracoMinimumVersion), $(UmbracoMaximumVersion)]" />
    <PackageVersion Include="Umbraco.Cms" Version="[$(UmbracoVersion)]" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="[$(UmbracoVersion)]" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>
</Project>
