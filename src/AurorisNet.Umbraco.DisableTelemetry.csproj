<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>AurorisNet.Umbraco.DisableTelemetry</PackageId>
    <Title>Umbraco Disable Telemetry</Title>
    <!-- Local builds use count 0; the release workflow supplies the published count. -->
    <Version>$(UmbracoMaximumVersion).0</Version>
    <Authors>Auroris</Authors>
    <Description>Stops Umbraco's telemetry beacon, installer reporting and dashboard news requests on servers without internet access. Registers automatically in Umbraco 17 and 18 through dependency injection.</Description>
    <PackageTags>umbraco;umbraco-marketplace;telemetry;offline;backoffice</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/auroris/UmbracoDisableTelemetry</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/UmbracoDisableTelemetry</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/auroris/UmbracoDisableTelemetry/releases/tag/v$(Version)</PackageReleaseNotes>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Infrastructure" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <InternalsVisibleTo Include="AurorisNet.Umbraco.DisableTelemetry.Tests" />
    <!-- nuget.org removes HTML comments before rendering, so the umbraco-releases markers in the README stay hidden there. -->
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../docs/images/icon.png" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
